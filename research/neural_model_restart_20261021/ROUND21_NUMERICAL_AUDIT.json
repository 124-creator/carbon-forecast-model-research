  "formula_audit": {
    "transition": "Snext=(1-phi)*mu+phi*S*exp(sqrt(q)Z-q/2). GH16 weights approximate E shock=1. S-linear interpolation preserves the clipped GH mean; no exact claim at clipping boundaries.",
    "row_error_decomposition": "actual_mean-ideal = interpolation_roundoff + clipped_GH_minus_raw_GH + GH_minus_continuous_ideal",
    "clip_mass": "ct=filtered_posterior_{t-1} dot row_clip_mass, evaluated before observation t; not max row probability",
    "boundary_mass": "bt=filtered_posterior_t[0]+filtered_posterior_t[-1], not equal to ct",
    "cancellation": "source reports abs(pi*row_mean_error); pi*abs(row_mean_error) is a stronger noncancelling diagnostic",
    "interpolation_variance": "Each bracket adds (x-L)*(H-x) to second moment, <=sinh(log_spacing/2)^2*x^2. Zero mean interpolation error does not imply variance preservation.",
    "forecast_mean": "analytic mu+phi^k*(filtered_mean-mu) is correct for the unbounded working process, not necessarily for repeated clipped finite-grid transitions",
    "posterior_joint": "J(S,M) proportional to transition_prior(S)*positive_hurdle(v)*prior_M(v)*p(shape|M)*Gamma(y|S,M,shape). Mpost integrates over prior(S); positive hurdle cancels from its normalization.",
    "zero_branch": "p0(v) independent of S,M; posterior(S)=transition_prior(S), evidence=logp0; Mpost all-zero sentinel with validity=false, not an M distribution.",
    "future_factor": "forecast = scale*E(Sfuture|history)*E_V[(1-p0(V))*sum_M priorM(V)*global_cM/c_ref]; independence of future volume and S innovations is a working assumption.",
    "prior_log_floor": "clamp_min(1e-300) injects <=grid_size*1e-300 prior mass. Conditional posterior influence has no uniform bound without a likelihood-ratio bound.",
    "identification": "No trueN, effective physical trading counts, activity A or IV identified."
  },
