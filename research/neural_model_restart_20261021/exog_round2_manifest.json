  "rules": {
    "target": "Only unaltered canonical panel date/price/market; source price is audit only; no target_* column read.",
    "features": "Only nine named daily levels; no historical derived, monthly, policy or endogenous columns.",
    "matching": "Latest original source ROW strictly earlier than canonical origin date, backward asof, allow_exact_matches=False. Original lag1 names are nominal only; impose additional earlier-source-row lag.",
    "missingness": "No bfill, no interpolation, no zero fill. Missing factor in selected latest row stays NaN/mask false; do not search older nonmissing factor rows.",
    "observed_mask_semantics": "Finite value present in archived source row, NOT proof of a raw upstream observation or known publication time. Prior upstream imputation cannot be excluded.",
    "availability": "Source daily timestamps, time zones, actual publication dates, historical vintages and legacy lag construction NOT independently verified. Candidate stage only; strict source-date rule cannot establish real-time availability.",
    "levels_units": "Original scale preserved without normalization or currency conversion. Oil/gas instrument and contract units unverified; stock/VIX presumed index points; HUBEI FX near hundreds vs GZ near single digits suggests per-100 vs per-1 currency quoting. No units silently inferred into conversions.",
    "negative_values": "Retained as original numeric levels; WTI negative values can be legitimate. Do not log nonpositive values; downstream transformation requires masks and training-only fit.",
    "source_age": "Calendar days since selected original row, not publication lag; -1/NaT for no source. Age can become stale at sparse dates/tails and must be handled explicitly downstream.",
    "no_history_pooling": "Each of HUBEI/GUANGZHOU/EU uses only its own source; no market target extension and no factor stitching.",
    "unsupported_markets": "CEA and SH excluded. Shared global source not admitted: unverified units and material same-date cross-source disagreement. No fabricated coverage."
  },
